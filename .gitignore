# Visual Studio / MSBuild
.vs/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.user
*.aps
*.pdb
*.ilk
*.obj

# vcpkg manifest 설치 산출물 (vcpkg.json으로 재현 가능하므로 커밋 제외)
vcpkg_installed/

# 실행 캡처 로그(앱 stdout/stderr를 파일로 받은 것 — 커밋 대상 아님)
*.out
*.err
*_out.txt
*_err.txt
*_stderr.txt

# 서버 런타임 산출물 (계정/채팅 DB — 로컬 데이터, 커밋 대상 아님)
*.db
*.db-shm
*.db-wal

# AI 서브프로젝트 (GuideStoryAI) — requirements.txt로 재현 가능하므로 환경은 커밋 제외.
# 데이터·체크포인트도 제외하되, models/*.pt(TorchScript, 수 MB)는 커밋한다.
# 그게 없으면 C++ libtorch 통합(P-017)을 아무도 재현할 수 없다.
GuideStoryAI/.venv/
GuideStoryAI/data/
GuideStoryAI/runs/
__pycache__/
*.pyc
